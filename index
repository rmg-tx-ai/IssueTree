<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>IssueTree</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #f2efe9;
      --dot:       #cfc8be;
      --navy:      #1c2b3a;
      --green:     #166638;
      --teal:      #0e4d6c;
      --rust:      #7d3512;
      --ink:       #1c2b3a;
      --mid:       #5a6e80;
      --faint:     #9aacba;
      --white:     #ffffff;
      --surface:   #faf9f6;
      --border:    #e2ddd6;
      --shadow-sm: 0 1px 4px rgba(28,43,58,.07);
      --shadow-md: 0 4px 16px rgba(28,43,58,.10);
      --shadow-lg: 0 8px 32px rgba(28,43,58,.14);
      --r:         9px;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px);
      background-size: 24px 24px;
      overflow: hidden;
      width: 100vw; height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Views ── */
    #home-view, #editor-view { position: fixed; inset: 0; }
    #home-view  { overflow-y: auto; z-index: 10; }
    #editor-view { z-index: 5; }

    /* ══════════════════════════════════════
       HOME SCREEN
    ══════════════════════════════════════ */
    #home-inner {
      max-width: 920px;
      margin: 0 auto;
      padding: 60px 32px 80px;
    }
    #home-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      margin-bottom: 44px;
    }
    #home-logo {
      display: block;
      font-family: 'Libre Baskerville', serif;
      font-size: 32px; color: var(--navy);
      letter-spacing: -1px; line-height: 1;
    }
    #home-tagline {
      display: block;
      font-size: 12px; color: var(--faint);
      font-weight: 500; margin-top: 7px; letter-spacing: .3px;
    }
    #btn-new-tree {
      background: var(--navy); color: #fff;
      border: none; border-radius: 10px;
      padding: 10px 20px; font-size: 13px; font-weight: 600;
      font-family: inherit; cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background .12s, transform .1s;
    }
    #btn-new-tree:hover { background: #2d3f50; transform: translateY(-1px); }

    #home-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(228px, 1fr));
      gap: 14px;
    }
    .tree-card {
      background: rgba(250,249,246,.96);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px 16px 14px;
      cursor: pointer; position: relative;
      transition: transform .12s, box-shadow .12s;
      box-shadow: var(--shadow-sm);
    }
    .tree-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .tree-card-name {
      font-family: 'Libre Baskerville', serif;
      font-size: 13.5px; color: var(--navy);
      line-height: 1.35; margin-bottom: 10px;
      padding-right: 26px; word-break: break-word;
    }
    .tree-card-meta { font-size: 10.5px; color: var(--faint); font-weight: 500; }
    .tree-card-btn {
      position: absolute; top: 10px; right: 10px;
      background: transparent; border: none;
      color: var(--faint); font-size: 15px; line-height: 1;
      cursor: pointer; border-radius: 6px;
      width: 26px; height: 26px;
      display: flex; align-items: center; justify-content: center;
      transition: background .1s, color .1s;
    }
    .tree-card-btn:hover { background: var(--border); color: var(--mid); }

    #home-empty {
      text-align: center; padding: 80px 20px;
      color: var(--faint); font-size: 14px;
    }
    #home-empty .empty-cta {
      margin-top: 14px; background: transparent;
      border: 1.5px solid var(--border); border-radius: 8px;
      padding: 8px 16px; font-size: 12px; font-weight: 600;
      color: var(--mid); cursor: pointer; font-family: inherit;
      transition: background .12s;
    }
    #home-empty .empty-cta:hover { background: var(--border); color: var(--ink); }

    /* ── Card context menu ── */
    #card-menu {
      position: fixed; z-index: 1100;
      background: var(--white); border-radius: 11px; padding: 5px;
      min-width: 158px;
      box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
      display: none; animation: menuIn .12s ease;
    }
    .card-item {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 12px; border-radius: 7px;
      font-size: 12px; font-weight: 500; color: var(--ink);
      cursor: pointer; transition: background .1s;
    }
    .card-item:hover { background: var(--bg); }
    .card-item.danger { color: #b03020; }
    .card-item.danger:hover { background: #fdecea; }
    .card-sep { height: 1px; background: var(--border); margin: 4px 5px; }

    /* ── New Tree Modal ── */
    #new-tree-overlay {
      position: fixed; inset: 0; z-index: 1200;
      background: rgba(28,43,58,.18);
      backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
      display: none; align-items: center; justify-content: center;
    }
    #new-tree-modal {
      background: var(--white); border-radius: 16px;
      padding: 26px 26px 22px; width: 400px;
      box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
      animation: modalIn .18s cubic-bezier(.34,1.4,.64,1);
    }
    #ntm-title {
      font-family: 'Libre Baskerville', serif;
      font-size: 16px; color: var(--navy); margin-bottom: 18px;
    }
    .ntm-label {
      font-size: 10.5px; font-weight: 700; color: var(--mid);
      letter-spacing: .5px; text-transform: uppercase; margin-bottom: 7px;
    }
    #ntm-name {
      width: 100%; padding: 9px 12px;
      border: 1.5px solid var(--border); border-radius: 8px;
      font-size: 13px; font-family: inherit; color: var(--ink);
      outline: none; background: var(--surface);
      transition: border-color .15s; margin-bottom: 18px;
    }
    #ntm-name:focus { border-color: var(--teal); background: #fff; }
    #ntm-templates {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 8px; margin-bottom: 20px;
    }
    .tpl-opt input[type="radio"] { display: none; }
    .tpl-card {
      border: 1.5px solid var(--border); border-radius: 9px;
      padding: 10px 12px; cursor: pointer;
      background: var(--surface);
      transition: border-color .12s, background .12s;
    }
    .tpl-opt input:checked + .tpl-card {
      border-color: var(--teal);
      background: rgba(14,77,108,.06);
    }
    .tpl-card-title { font-size: 11.5px; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
    .tpl-card-desc  { font-size: 10px; color: var(--faint); }
    .ntm-btns { display: flex; gap: 8px; justify-content: flex-end; }

    /* ══════════════════════════════════════
       EDITOR — TOOLBAR
    ══════════════════════════════════════ */
    #toolbar {
      position: fixed; top: 16px; left: 50%;
      transform: translateX(-50%);
      z-index: 500;
      background: rgba(250,249,246,.94);
      backdrop-filter: blur(14px) saturate(1.4);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      border-radius: 14px;
      padding: 8px 12px;
      display: flex; align-items: center; gap: 6px;
      white-space: nowrap;
      box-shadow: var(--shadow-md), 0 0 0 1px var(--border);
    }
    #tb-title {
      font-family: 'Libre Baskerville', serif;
      font-size: 13px; color: var(--navy);
      letter-spacing: -.1px; cursor: text;
      border-radius: 4px; padding: 2px 5px;
      outline: none; min-width: 30px; max-width: 180px;
      overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
      transition: background .1s;
    }
    #tb-title:hover  { background: rgba(28,43,58,.05); }
    #tb-title:focus  { background: #fff; box-shadow: 0 0 0 2px var(--teal); }
    .tsep { width: 1px; height: 18px; background: var(--border); margin: 0 2px; }
    .tbtn {
      background: transparent; border: none;
      color: var(--mid); border-radius: 7px;
      padding: 5px 9px; font-size: 11.5px; font-weight: 600;
      font-family: inherit; cursor: pointer;
      transition: background .12s, color .12s;
    }
    .tbtn:hover  { background: var(--border); color: var(--ink); }
    .tbtn.on     { background: var(--navy); color: #fff; }
    .tbtn.on:hover { background: #2d3f50; }
    .tbtn.danger { color: #b03020; }
    .tbtn.danger:hover { background: #fdecea; }

    /* Search */
    .srch { position: relative; display: flex; align-items: center; }
    .srch-icon { position: absolute; left: 8px; color: var(--faint); font-size: 12px; pointer-events: none; }
    #search-input {
      padding: 5px 26px 5px 26px;
      border: 1.5px solid var(--border); border-radius: 7px;
      font-size: 11.5px; font-family: inherit; color: var(--ink);
      background: var(--surface); outline: none; width: 148px;
      transition: border-color .15s, width .2s, background .15s;
    }
    #search-input:focus { border-color: var(--teal); width: 186px; background: #fff; }
    #search-input::placeholder { color: var(--faint); }
    #srch-clear { position: absolute; right: 7px; font-size: 10px; color: var(--faint); cursor: pointer; display: none; }
    #srch-clear:hover { color: var(--mid); }
    #save-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--faint); margin-left: 2px;
      transition: background .3s;
    }

    /* Export dropdown */
    #export-wrap { position: relative; }
    #export-menu {
      position: absolute; top: calc(100% + 6px); right: 0;
      background: var(--white); border-radius: 10px; padding: 5px;
      min-width: 128px;
      box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
      display: none; z-index: 600; animation: menuIn .12s ease;
    }
    .exp-item {
      display: flex; align-items: center; gap: 8px;
      padding: 7px 11px; border-radius: 7px;
      font-size: 12px; font-weight: 500; color: var(--ink);
      cursor: pointer; transition: background .1s;
    }
    .exp-item:hover { background: var(--bg); }
    .exp-icon { width: 16px; text-align: center; font-size: 11px; color: var(--mid); }

    /* ── Hint ── */
    #hint {
      position: fixed; bottom: 16px; left: 50%;
      transform: translateX(-50%);
      background: rgba(250,249,246,.88);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      border-radius: 20px; padding: 5px 16px;
      font-size: 10.5px; color: var(--faint);
      box-shadow: var(--shadow-sm), 0 0 0 1px var(--border);
      z-index: 200; pointer-events: none; white-space: nowrap;
    }
    #hint strong { color: var(--mid); font-weight: 600; }

    /* Legend */
    #legend {
      position: fixed; bottom: 16px; right: 16px;
      display: flex; gap: 10px; align-items: center;
      background: rgba(250,249,246,.88);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      border-radius: 20px; padding: 5px 12px;
      box-shadow: var(--shadow-sm), 0 0 0 1px var(--border);
      z-index: 200;
    }
    .leg     { display: flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; color: var(--mid); }
    .leg-dot { width: 8px; height: 8px; border-radius: 2px; }

    /* ── Canvas ── */
    #viewport  { width: 100vw; height: 100vh; overflow: hidden; position: relative; }
    #canvas    { position: absolute; top: 0; left: 0; transform-origin: 0 0; will-change: transform; }
    #svg-layer { position: absolute; top: 0; left: 0; pointer-events: none; overflow: visible; }

    /* ── Nodes ── */
    .node {
      position: absolute; border-radius: var(--r);
      cursor: pointer; user-select: none;
      transition: box-shadow .14s, transform .12s, opacity .18s;
    }
    .node:hover:not(.leaf) { transform: translateY(-1px); }
    .node.leaf { cursor: text; }
    .node.leaf:hover { transform: translateY(-1px); }
    .node.dimmed { opacity: 0.12; pointer-events: none; }
    .node.highlighted {
      box-shadow: 0 0 0 2.5px #e8a020, 0 4px 18px rgba(232,160,32,.2) !important;
      z-index: 2;
    }
    .node-body    { display: flex; align-items: center; height: 100%; padding: 0 10px 0 13px; gap: 7px; }
    .node-lbl     { flex: 1; font-weight: 600; line-height: 1.3; }
    .node-count   { font-size: 9px; font-weight: 700; letter-spacing: .3px; background: rgba(0,0,0,.1); border-radius: 8px; padding: 1px 6px; flex-shrink: 0; }
    .node-chevron { flex-shrink: 0; font-size: 7px; opacity: .45; transition: transform .2s; margin-left: 1px; }
    .node-chevron.open { transform: rotate(90deg); }

    /* ── Context menu ── */
    #ctx-menu {
      position: fixed; z-index: 600;
      background: var(--white); border-radius: 11px; padding: 5px;
      min-width: 170px;
      box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
      display: none; animation: menuIn .12s ease;
    }
    @keyframes menuIn {
      from { opacity:0; transform: scale(.95) translateY(-4px); }
      to   { opacity:1; transform: scale(1)  translateY(0); }
    }
    .ctx-item {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 12px; border-radius: 7px;
      font-size: 12px; font-weight: 500; color: var(--ink);
      cursor: pointer; transition: background .1s;
    }
    .ctx-item:hover { background: var(--bg); }
    .ctx-item .ctx-icon { font-size: 13px; width: 16px; text-align: center; opacity: .7; }
    .ctx-item.danger { color: #b03020; }
    .ctx-item.danger:hover { background: #fdecea; }
    .ctx-item.disabled { opacity: .35; pointer-events: none; }
    .ctx-sep { height: 1px; background: var(--border); margin: 4px 5px; }

    /* ── Add / Rename modal ── */
    #modal-overlay {
      position: fixed; inset: 0; z-index: 700;
      background: rgba(28,43,58,.18);
      backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
      display: none; align-items: center; justify-content: center;
      animation: fadeIn .15s ease;
    }
    @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
    #modal {
      background: var(--white); border-radius: 14px;
      padding: 20px 22px; min-width: 320px;
      box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
      animation: modalIn .18s cubic-bezier(.34,1.4,.64,1);
    }
    @keyframes modalIn {
      from { opacity:0; transform: scale(.94) translateY(8px); }
      to   { opacity:1; transform: scale(1)  translateY(0); }
    }
    #modal-title { font-size: 13px; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    #modal-sub   { font-size: 11px; color: var(--faint); margin-bottom: 14px; }
    #modal-input {
      width: 100%; padding: 9px 12px;
      border: 1.5px solid var(--border); border-radius: 8px;
      font-size: 13px; font-family: inherit; color: var(--ink);
      outline: none; background: var(--surface);
      transition: border-color .15s;
    }
    #modal-input:focus { border-color: var(--teal); background: #fff; }
    .modal-btns { display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px; }
    .mbtn { padding: 7px 16px; border-radius: 7px; border: none; font-size: 12px; font-weight: 600; font-family: inherit; cursor: pointer; transition: background .12s; }
    .mbtn.cancel { background: var(--bg); color: var(--mid); }
    .mbtn.cancel:hover { background: var(--border); }
    .mbtn.ok { background: var(--navy); color: #fff; }
    .mbtn.ok:hover { background: #2d3f50; }

    /* Inline rename input */
    .rename-input {
      position: fixed; z-index: 650;
      border: 2px solid var(--teal); border-radius: var(--r);
      background: #fff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 600; color: var(--ink);
      outline: none; padding: 0 13px;
      box-shadow: 0 0 0 4px rgba(14,77,108,.12);
    }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════════════
     HOME VIEW
══════════════════════════════════════════════ -->
<div id="home-view" style="display:none">
  <div id="home-inner">
    <div id="home-header">
      <div>
        <span id="home-logo">IssueTree</span>
        <span id="home-tagline">Structured problem-solving</span>
      </div>
      <button id="btn-new-tree" onclick="showNewTreeModal()">+ New Tree</button>
    </div>
    <div id="home-grid"></div>
    <div id="home-empty" style="display:none">
      <p>No issue trees yet.</p>
      <button class="empty-cta" onclick="showNewTreeModal()">Create your first tree →</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════
     EDITOR VIEW
══════════════════════════════════════════════ -->
<div id="editor-view" style="display:none">

  <!-- Toolbar -->
  <div id="toolbar">
    <button class="tbtn" onclick="goHome()" style="letter-spacing:-.3px;padding-left:7px">← Trees</button>
    <div class="tsep"></div>
    <span id="tb-title"
          contenteditable="true"
          spellcheck="false"
          onblur="saveTitleEdit()"
          onkeydown="handleTitleKeydown(event)">Tree</span>
    <div class="tsep"></div>
    <div class="srch">
      <span class="srch-icon">⌕</span>
      <input id="search-input" type="text" placeholder="Search…" autocomplete="off" oninput="onSearch(this.value)"/>
      <span id="srch-clear" onclick="clearSearch()">✕</span>
    </div>
    <div class="tsep"></div>
    <button class="tbtn" id="btn-l1"  onclick="setDepth(1)">L1</button>
    <button class="tbtn" id="btn-l2"  onclick="setDepth(2)">L2</button>
    <button class="tbtn" id="btn-all" onclick="setDepth(99)">All</button>
    <div class="tsep"></div>
    <button class="tbtn" onclick="fitView()">Fit ⊡</button>
    <div class="tsep"></div>
    <div id="export-wrap">
      <button class="tbtn" id="btn-export" onclick="toggleExportMenu()">Export ▾</button>
      <div id="export-menu">
        <div class="exp-item" onclick="exportJSON()"><span class="exp-icon">{ }</span>JSON</div>
        <div class="exp-item" onclick="exportPNG()"><span class="exp-icon">⬜</span>PNG</div>
        <div class="exp-item" onclick="exportPDF()"><span class="exp-icon">▣</span>PDF</div>
      </div>
    </div>
    <input type="file" id="import-file" accept=".json" style="display:none" onchange="importJSON(this)"/>
    <button class="tbtn" onclick="document.getElementById('import-file').click()" title="Import JSON tree">↑ Import</button>
    <div class="tsep"></div>
    <div id="save-dot" title="Auto-saved"></div>
  </div>

  <!-- Hint -->
  <div id="hint">Scroll to pan &nbsp;·&nbsp; Pinch to zoom &nbsp;·&nbsp; Click to expand &nbsp;·&nbsp; <strong>Right-click</strong> any node to add, rename, or delete &nbsp;·&nbsp; <strong>Double-click</strong> to rename</div>

  <!-- Legend -->
  <div id="legend">
    <div class="leg"><div class="leg-dot" style="background:var(--green)"></div>Pricing</div>
    <div class="leg"><div class="leg-dot" style="background:var(--teal)"></div>Volume</div>
    <div class="leg"><div class="leg-dot" style="background:var(--rust)"></div>Cost</div>
  </div>

  <!-- Canvas -->
  <div id="viewport">
    <div id="canvas">
      <svg id="svg-layer"></svg>
    </div>
  </div>

  <!-- Context menu -->
  <div id="ctx-menu">
    <div class="ctx-item" id="ctx-add"    onclick="ctxDoAdd()">   <span class="ctx-icon">＋</span> Add child node</div>
    <div class="ctx-item" id="ctx-rename" onclick="ctxDoRename()"><span class="ctx-icon">✎</span> Rename</div>
    <div class="ctx-item" id="ctx-color"  onclick="ctxDoColor()" style="display:none"><span class="ctx-icon">◉</span> Change color</div>
    <div class="ctx-sep"></div>
    <div class="ctx-item danger" id="ctx-delete" onclick="ctxDoDelete()"><span class="ctx-icon">✕</span> Delete node</div>
  </div>

  <!-- Add / Rename modal -->
  <div id="modal-overlay" onclick="closeModal(event)">
    <div id="modal">
      <div id="modal-title">Add child node</div>
      <div id="modal-sub">Under: <span id="modal-parent-label"></span></div>
      <input id="modal-input" type="text" placeholder="Node label…" />
      <div class="modal-btns">
        <button class="mbtn cancel" onclick="closeModal()">Cancel</button>
        <button class="mbtn ok" id="modal-ok" onclick="confirmModal()">Add</button>
      </div>
    </div>
  </div>

</div><!-- /editor-view -->

<!-- ══════════════════════════════════════════════
     NEW TREE MODAL  (always in DOM, above both views)
══════════════════════════════════════════════ -->
<div id="new-tree-overlay" onclick="if(event.target===this)hideNewTreeModal()">
  <div id="new-tree-modal">
    <div id="ntm-title">New Tree</div>
    <div class="ntm-label">Name</div>
    <input id="ntm-name" type="text" placeholder="My Issue Tree…" autocomplete="off"/>
    <div class="ntm-label">Template</div>
    <div id="ntm-templates">
      <label class="tpl-opt">
        <input type="radio" name="tpl" value="blank" checked/>
        <div class="tpl-card">
          <div class="tpl-card-title">Blank</div>
          <div class="tpl-card-desc">Start from scratch</div>
        </div>
      </label>
      <label class="tpl-opt">
        <input type="radio" name="tpl" value="mckinsey"/>
        <div class="tpl-card">
          <div class="tpl-card-title">Issue Tree</div>
          <div class="tpl-card-desc">McKinsey 3-branch</div>
        </div>
      </label>
      <label class="tpl-opt">
        <input type="radio" name="tpl" value="rca"/>
        <div class="tpl-card">
          <div class="tpl-card-title">Root Cause</div>
          <div class="tpl-card-desc">4 fishbone branches</div>
        </div>
      </label>
      <label class="tpl-opt">
        <input type="radio" name="tpl" value="vz"/>
        <div class="tpl-card">
          <div class="tpl-card-title">VZ Telecom</div>
