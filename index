<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>VZ Issue Tree</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #f2efe9;
      --dot:       #cfc8be;
      --navy:      #1c2b3a;
      --green:     #166638;
      --teal:      #0e4d6c;
      --rust:      #7d3512;
      --ink:       #1c2b3a;
      --mid:       #5a6e80;
      --faint:     #9aacba;
      --white:     #ffffff;
      --surface:   #faf9f6;
      --border:    #e2ddd6;
      --shadow-sm: 0 1px 4px rgba(28,43,58,.07);
      --shadow-md: 0 4px 16px rgba(28,43,58,.10);
      --shadow-lg: 0 8px 32px rgba(28,43,58,.14);
      --r:         9px;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px);
      background-size: 24px 24px;
      overflow: hidden;
      width: 100vw; height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Toolbar ── */
    #toolbar {
      position: fixed; top: 16px; left: 50%;
      transform: translateX(-50%);
      z-index: 500;
      background: rgba(250,249,246,.94);
      backdrop-filter: blur(14px) saturate(1.4);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      border-radius: 14px;
      padding: 8px 12px;
      display: flex; align-items: center; gap: 6px;
      white-space: nowrap;
      box-shadow: var(--shadow-md), 0 0 0 1px var(--border);
    }
    #tb-title {
      font-family: 'Libre Baskerville', serif;
      font-size: 13px; color: var(--navy);
      margin-right: 4px; letter-spacing: -.1px;
    }
    .tsep { width: 1px; height: 18px; background: var(--border); margin: 0 2px; }

    .tbtn {
      background: transparent; border: none;
      color: var(--mid); border-radius: 7px;
      padding: 5px 9px; font-size: 11.5px; font-weight: 600;
      font-family: inherit; cursor: pointer;
      transition: background .12s, color .12s;
    }
    .tbtn:hover { background: var(--border); color: var(--ink); }
    .tbtn.on { background: var(--navy); color: #fff; }
    .tbtn.on:hover { background: #2d3f50; }
    .tbtn.danger { color: #b03020; }
    .tbtn.danger:hover { background: #fdecea; }

    /* Search */
    .srch {
      position: relative; display: flex; align-items: center;
    }
    .srch-icon {
      position: absolute; left: 8px;
      color: var(--faint); font-size: 12px; pointer-events: none;
    }
    #search-input {
      padding: 5px 26px 5px 26px;
      border: 1.5px solid var(--border);
      border-radius: 7px; font-size: 11.5px;
      font-family: inherit; color: var(--ink);
      background: var(--surface); outline: none;
      width: 148px;
      transition: border-color .15s, width .2s, background .15s;
    }
    #search-input:focus { border-color: var(--teal); width: 186px; background: #fff; }
    #search-input::placeholder { color: var(--faint); }
    #srch-clear {
      position: absolute; right: 7px; font-size: 10px;
      color: var(--faint); cursor: pointer; display: none;
    }
    #srch-clear:hover { color: var(--mid); }
    #save-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--faint); margin-left: 2px;
      transition: background .3s;
    }

    /* ── Hint ── */
    #hint {
      position: fixed; bottom: 16px; left: 50%;
      transform: translateX(-50%);
      background: rgba(250,249,246,.88);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      border-radius: 20px; padding: 5px 16px;
      font-size: 10.5px; color: var(--faint);
      box-shadow: var(--shadow-sm), 0 0 0 1px var(--border);
      z-index: 200; pointer-events: none; white-space: nowrap;
    }
    #hint strong { color: var(--mid); font-weight: 600; }

    /* Legend */
    #legend {
      position: fixed; bottom: 16px; right: 16px;
      display: flex; gap: 10px; align-items: center;
      background: rgba(250,249,246,.88);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      border-radius: 20px; padding: 5px 12px;
      box-shadow: var(--shadow-sm), 0 0 0 1px var(--border);
      z-index: 200;
    }
    .leg { display: flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; color: var(--mid); }
    .leg-dot { width: 8px; height: 8px; border-radius: 2px; }

    /* ── Canvas ── */
    #viewport { width: 100vw; height: 100vh; overflow: hidden; position: relative; }
    #canvas { position: absolute; top: 0; left: 0; transform-origin: 0 0; will-change: transform; }
    #svg-layer { position: absolute; top: 0; left: 0; pointer-events: none; overflow: visible; }

    /* ── Nodes ── */
    .node {
      position: absolute; border-radius: var(--r);
      cursor: pointer; user-select: none;
      transition: box-shadow .14s, transform .12s, opacity .18s;
    }
    .node:hover:not(.leaf) { transform: translateY(-1px); }
    .node.leaf { cursor: text; }
    .node.leaf:hover { transform: translateY(-1px); }
    .node.dimmed { opacity: 0.12; pointer-events: none; }
    .node.highlighted {
      box-shadow: 0 0 0 2.5px #e8a020, 0 4px 18px rgba(232,160,32,.2) !important;
      z-index: 2;
    }

    .node-body {
      display: flex; align-items: center;
      height: 100%; padding: 0 10px 0 13px; gap: 7px;
    }
    .node-lbl { flex: 1; font-weight: 600; line-height: 1.3; }
    .node-count {
      font-size: 9px; font-weight: 700; letter-spacing: .3px;
      background: rgba(0,0,0,.1); border-radius: 8px;
      padding: 1px 6px; flex-shrink: 0;
    }
    .node-chevron {
      flex-shrink: 0; font-size: 7px; opacity: .45;
      transition: transform .2s; margin-left: 1px;
    }
    .node-chevron.open { transform: rotate(90deg); }

    /* ── Context menu ── */
    #ctx-menu {
      position: fixed; z-index: 600;
      background: var(--white);
      border-radius: 11px; padding: 5px;
      min-width: 170px;
      box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
      display: none;
      animation: menuIn .12s ease;
    }
    @keyframes menuIn {
      from { opacity:0; transform: scale(.95) translateY(-4px); }
      to   { opacity:1; transform: scale(1) translateY(0); }
    }
    .ctx-item {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 12px; border-radius: 7px;
      font-size: 12px; font-weight: 500; color: var(--ink);
      cursor: pointer;
      transition: background .1s;
    }
    .ctx-item:hover { background: var(--bg); }
    .ctx-item .ctx-icon { font-size: 13px; width: 16px; text-align: center; opacity: .7; }
    .ctx-item.danger { color: #b03020; }
    .ctx-item.danger:hover { background: #fdecea; }
    .ctx-item.disabled { opacity: .35; pointer-events: none; }
    .ctx-sep { height: 1px; background: var(--border); margin: 4px 5px; }

    /* ── Add / Rename modal ── */
    #modal-overlay {
      position: fixed; inset: 0; z-index: 700;
      background: rgba(28,43,58,.18);
      backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
      display: none; align-items: center; justify-content: center;
      animation: fadeIn .15s ease;
    }
    @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
    #modal {
      background: var(--white); border-radius: 14px;
      padding: 20px 22px; min-width: 320px;
      box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
      animation: modalIn .18s cubic-bezier(.34,1.4,.64,1);
    }
    @keyframes modalIn {
      from { opacity:0; transform: scale(.94) translateY(8px); }
      to   { opacity:1; transform: scale(1) translateY(0); }
    }
    #modal-title {
      font-size: 13px; font-weight: 700; color: var(--navy);
      margin-bottom: 4px;
    }
    #modal-sub {
      font-size: 11px; color: var(--faint); margin-bottom: 14px;
    }
    #modal-input {
      width: 100%; padding: 9px 12px;
      border: 1.5px solid var(--border); border-radius: 8px;
      font-size: 13px; font-family: inherit; color: var(--ink);
      outline: none; background: var(--surface);
      transition: border-color .15s;
    }
    #modal-input:focus { border-color: var(--teal); background: #fff; }
    .modal-btns {
      display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px;
    }
    .mbtn {
      padding: 7px 16px; border-radius: 7px; border: none;
      font-size: 12px; font-weight: 600; font-family: inherit;
      cursor: pointer; transition: background .12s;
    }
    .mbtn.cancel { background: var(--bg); color: var(--mid); }
    .mbtn.cancel:hover { background: var(--border); }
    .mbtn.ok { background: var(--navy); color: #fff; }
    .mbtn.ok:hover { background: #2d3f50; }

    /* Inline rename input (positioned over node) */
    .rename-input {
      position: fixed; z-index: 650;
      border: 2px solid var(--teal);
      border-radius: var(--r);
      background: #fff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 600; color: var(--ink);
      outline: none; padding: 0 13px;
      box-shadow: 0 0 0 4px rgba(14,77,108,.12);
    }
  </style>
</head>
<body>

<!-- ── Toolbar ── -->
<div id="toolbar">
  <span id="tb-title">VZ Issue Tree</span>
  <div class="tsep"></div>
  <div class="srch">
    <span class="srch-icon">⌕</span>
    <input id="search-input" type="text" placeholder="Search…" autocomplete="off" oninput="onSearch(this.value)"/>
    <span id="srch-clear" onclick="clearSearch()">✕</span>
  </div>
  <div class="tsep"></div>
  <button class="tbtn" id="btn-l1" onclick="setDepth(1)">L1</button>
  <button class="tbtn" id="btn-l2" onclick="setDepth(2)">L2</button>
  <button class="tbtn" id="btn-all" onclick="setDepth(99)">All</button>
  <div class="tsep"></div>
  <button class="tbtn" onclick="fitView()">Fit ⊡</button>
  <div class="tsep"></div>
  <button class="tbtn" onclick="exportJSON()" title="Download tree as JSON">↓ Export</button>
  <button class="tbtn" onclick="document.getElementById('import-file').click()" title="Load a saved JSON tree">↑ Import</button>
  <input type="file" id="import-file" accept=".json" style="display:none" onchange="importJSON(this)"/>
  <div class="tsep"></div>
  <button class="tbtn danger" onclick="hardReset()">Reset</button>
  <div id="save-dot" title="Auto-saved"></div>
</div>

<!-- ── Hint ── -->
<div id="hint">Scroll to pan &nbsp;·&nbsp; Pinch to zoom &nbsp;·&nbsp; Click to expand &nbsp;·&nbsp; <strong>Right-click</strong> any node to add, rename, or delete &nbsp;·&nbsp; <strong>Double-click</strong> to rename</div>

<!-- ── Legend ── -->
<div id="legend">
  <div class="leg"><div class="leg-dot" style="background:var(--green)"></div>Pricing</div>
  <div class="leg"><div class="leg-dot" style="background:var(--teal)"></div>Volume</div>
  <div class="leg"><div class="leg-dot" style="background:var(--rust)"></div>Cost</div>
</div>

<!-- ── Canvas ── -->
<div id="viewport">
  <div id="canvas">
    <svg id="svg-layer"></svg>
  </div>
</div>

<!-- ── Context menu ── -->
<div id="ctx-menu">
  <div class="ctx-item" id="ctx-add"    onclick="ctxDoAdd()">   <span class="ctx-icon">＋</span> Add child node</div>
  <div class="ctx-item" id="ctx-rename" onclick="ctxDoRename()"><span class="ctx-icon">✎</span> Rename</div>
  <div class="ctx-item" id="ctx-color"  onclick="ctxDoColor()" style="display:none"><span class="ctx-icon">◉</span> Change color</div>
  <div class="ctx-sep"></div>
  <div class="ctx-item danger" id="ctx-delete" onclick="ctxDoDelete()"><span class="ctx-icon">✕</span> Delete node</div>
</div>

<!-- ── Add / Rename modal ── -->
<div id="modal-overlay" onclick="closeModal(event)">
  <div id="modal">
    <div id="modal-title">Add child node</div>
    <div id="modal-sub">Under: <span id="modal-parent-label"></span></div>
    <input id="modal-input" type="text" placeholder="Node label…" />
    <div class="modal-btns">
      <button class="mbtn cancel" onclick="closeModal()">Cancel</button>
      <button class="mbtn ok" id="modal-ok" onclick="confirmModal()">Add</button>
    </div>
  </div>
</div>

