// ════════════════════════════════════════════════
// ROUTER
// ════════════════════════════════════════════════
function initRouter() {
  migrateIfNeeded();
  window.addEventListener('hashchange', route);
  route();
}

function route() {
  const hash = window.location.hash || '#/';
  if (hash.startsWith('#/tree/')) {
    const id = hash.slice(7);
    showView('editor');
    openTree(id);
  } else {
    showView('home');
    renderHome();
    if (hash === '#/new') showNewTreeModal();
  }
}

function showView(v) {
  document.getElementById('home-view').style.display   = v === 'home'   ? 'block' : 'none';
  document.getElementById('editor-view').style.display = v === 'editor' ? 'block' : 'none';
}

function goHome() { window.location.hash = '#/'; }

// ════════════════════════════════════════════════
// HOME SCREEN
// ════════════════════════════════════════════════
function renderHome() {
  const store  = loadStore();
  const trees  = Object.values(store.trees)
    .sort((a,b) => new Date(b.updatedAt) - new Date(a.updatedAt));
  const grid   = document.getElementById('home-grid');
  const empty  = document.getElementById('home-empty');
  grid.innerHTML = '';

  if (!trees.length) { empty.style.display = 'block'; return; }
  empty.style.display = 'none';

  trees.forEach(t => {
    const n   = countNodes(t.data);
    const div = document.createElement('div');
    div.className = 'tree-card';
    div.innerHTML = `
      <div class="tree-card-name">${escHtml(t.name)}</div>
      <div class="tree-card-meta">${n} node${n!==1?'s':''} &nbsp;·&nbsp; ${relTime(t.updatedAt)}</div>
      <button class="tree-card-btn" title="Options" onclick="showCardMenu(event,'${escHtml(t.id)}')">···</button>
    `;
    div.addEventListener('click', e => {
      if (e.target.closest('.tree-card-btn')) return;
      window.location.hash = '#/tree/' + t.id;
    });
    grid.appendChild(div);
  });
}

// Card context menu
let cardMenuTargetId = null;

function showCardMenu(e, id) {
  e.stopPropagation();
  cardMenuTargetId = id;
  const menu = document.getElementById('card-menu');
  menu.style.display = 'block';
  menu.style.left = e.clientX + 'px';
  menu.style.top  = e.clientY + 'px';
  requestAnimationFrame(() => {
    const r = menu.getBoundingClientRect();
    if (r.right  > window.innerWidth  - 8) menu.style.left = (e.clientX - r.width)  + 'px';
    if (r.bottom > window.innerHeight - 8) menu.style.top  = (e.clientY - r.height) + 'px';
  });
}
function hideCardMenu() { document.getElementById('card-menu').style.display='none'; cardMenuTargetId=null; }

function openTreeFromCard() {
  const id = cardMenuTargetId; hideCardMenu();
  window.location.hash = '#/tree/' + id;
}
function renameTreeCard() {
  const id = cardMenuTargetId; hideCardMenu();
  const store = loadStore();
  const t = store.trees[id]; if (!t) return;
  const name = prompt('Rename tree:', t.name);
  if (!name || !name.trim()) return;
  t.name = name.trim();
  saveStore(store);
  renderHome();
}
function duplicateTreeCard() {
  const id = cardMenuTargetId; hideCardMenu();
  const store = loadStore();
  const t = store.trees[id]; if (!t) return;
  const newId = genId();
  store.trees[newId] = {
    id: newId,
    name: t.name + ' (copy)',
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    data: clone(t.data)
  };
  saveStore(store);
  renderHome();
}
function deleteTreeCard() {
  const id = cardMenuTargetId; hideCardMenu();
  const store = loadStore();
  const t = store.trees[id]; if (!t) return;
  if (!confirm('Delete "' + t.name + '"? This cannot be undone.')) return;
  delete store.trees[id];
  if (store.activeId === id) store.activeId = null;
  saveStore(store);
  renderHome();
}

// New tree modal
function showNewTreeModal() {
  document.getElementById('new-tree-overlay').style.display = 'flex';
  const inp = document.getElementById('ntm-name');
  inp.value = '';
  document.querySelector('input[name="tpl"][value="blank"]').checked = true;
  setTimeout(() => inp.focus(), 60);
}
function hideNewTreeModal() {
  document.getElementById('new-tree-overlay').style.display = 'none';
  if (window.location.hash === '#/new') history.replaceState(null, '', '#/');
}
function confirmNewTree() {
  const name   = document.getElementById('ntm-name').value.trim() || 'Untitled Tree';
  const tplKey = document.querySelector('input[name="tpl"]:checked')?.value || 'blank';
  const tplData = TEMPLATES[tplKey] || TEMPLATES.blank;
  const newId  = genId();
  const store  = loadStore();
  const data   = clone(tplData);
  // Sync root label to tree name for non-VZ templates
  if (tplKey !== 'vz') data.label = name;
  store.trees[newId] = {
    id: newId, name,
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    data
  };
  store.activeId = newId;
  saveStore(store);
  hideNewTreeModal();
  window.location.hash = '#/tree/' + newId;
}

document.getElementById('ntm-name').addEventListener('keydown', e => {
  if (e.key === 'Enter')  { e.preventDefault(); confirmNewTree(); }
  if (e.key === 'Escape') hideNewTreeModal();
  e.stopPropagation();
});

// ════════════════════════════════════════════════
// OPEN TREE  (enter editor for a specific tree id)
// ════════════════════════════════════════════════
function openTree(id) {
  const store = loadStore();
  const rec   = store.trees[id];
  if (!rec) { window.location.hash = '#/'; return; }

  currentTreeId = id;
  tree = clone(rec.data);
  store.activeId = id;
  saveStore(store);

  document.getElementById('tb-title').textContent = rec.name;
  clearSearch();
  render();
  setDepth(1);
}

// Editable toolbar title
function saveTitleEdit() {
  const el = document.getElementById('tb-title');
  const v  = el.textContent.trim();
  if (!currentTreeId) return;
  const store = loadStore();
  if (!store.trees[currentTreeId]) return;
  if (v) {
    store.trees[currentTreeId].name = v;
    saveStore(store);
  } else {
    el.textContent = store.trees[currentTreeId].name;
  }
}
function handleTitleKeydown(e) {
  if (e.key === 'Enter')  { e.preventDefault(); e.target.blur(); }
  if (e.key === 'Escape') {
    const store = loadStore();
    if (currentTreeId && store.trees[currentTreeId])
      e.target.textContent = store.trees[currentTreeId].name;
    e.target.blur();
  }
  e.stopPropagation();
}

// ════════════════════════════════════════════════
// PERSISTENCE
// ════════════════════════════════════════════════
function save() {
  if (!currentTreeId || !tree) return;
  const store = loadStore();
  if (store.trees[currentTreeId]) {
    store.trees[currentTreeId].data      = tree;
    store.trees[currentTreeId].updatedAt = new Date().toISOString();
    saveStore(store);
  }
  const d = document.getElementById('save-dot');
  if (d) {
    d.style.background = '#60b87a';
    clearTimeout(save._t);
    save._t = setTimeout(() => d.style.background = 'var(--faint)', 1200);
  }
}
function clone(o) { return JSON.parse(JSON.stringify(o)); }

function hardReset() {
  if (!currentTreeId) return;
  if (!confirm('Reset this tree to the VZ default? All edits will be lost.')) return;
  const store = loadStore();
  if (store.trees[currentTreeId]) {
    store.trees[currentTreeId].data      = clone(DEFAULT);
    store.trees[currentTreeId].updatedAt = new Date().toISOString();
    saveStore(store);
    tree = clone(DEFAULT);
  }
  clearSearch(); render(); fitView();
}

// ════════════════════════════════════════════════
// EXPORT / IMPORT
// ════════════════════════════════════════════════
function exportJSON() {
  hideExportMenu();
  if (!tree) return;
  const store = loadStore();
  const name  = store.trees[currentTreeId]?.name || 'tree';
  const slug  = name.replace(/\s+/g,'-').toLowerCase().replace(/[^a-z0-9-]/g,'');
  const date  = new Date().toISOString().slice(0,10);
  const blob  = new Blob([JSON.stringify(tree,null,2)], {type:'application/json'});
  const url   = URL.createObjectURL(blob);
  const a     = document.createElement('a');
  a.href = url; a.download = `issue-tree-${slug}-${date}.json`;
  a.click(); URL.revokeObjectURL(url);
}

function importJSON(input) {
  const file = input.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const parsed = JSON.parse(e.target.result);
      if (!parsed.id || !parsed.label) { alert('Invalid issue tree JSON.'); return; }
      if (!confirm('Load "' + parsed.label + '"? This will replace the current tree.')) return;
      tree = parsed; save(); clearSearch(); render(); fitView();
    } catch(err) { alert('Could not parse JSON: ' + err.message); }
    input.value = '';
  };
  reader.readAsText(file);
}

// Export dropdown
function toggleExportMenu() {
  const m = document.getElementById('export-menu');
  m.style.display = m.style.display === 'block' ? 'none' : 'block';
}
function hideExportMenu() { document.getElementById('export-menu').style.display = 'none'; }

async function exportPNG() {
  hideExportMenu();
  if (!window.html2canvas) {
    alert('PNG export requires an internet connection (html2canvas CDN not loaded).');
    return;
  }
  const c = document.getElementById('canvas');
  const savedT = c.style.transform;
  c.style.transform = 'none';
  try {
    const store = loadStore();
    const name  = store.trees[currentTreeId]?.name || 'tree';
    const slug  = name.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'');
    const cap   = await html2canvas(c, { backgroundColor:'#f2efe9', scale:2, useCORS:true, logging:false });
    const a = document.createElement('a');
    a.download = slug + '-' + new Date().toISOString().slice(0,10) + '.png';
    a.href = cap.toDataURL('image/png');
    a.click();
  } finally { c.style.transform = savedT; }
}

async function exportPDF() {
  hideExportMenu();
  if (!window.html2canvas || !window.jspdf) {
    alert('PDF export requires an internet connection (CDN libraries not loaded).');
    return;
  }
  const c = document.getElementById('canvas');
  const savedT = c.style.transform;
  c.style.transform = 'none';
  try {
    const store = loadStore();
    const name  = store.trees[currentTreeId]?.name || 'tree';
    const slug  = name.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'');
    const cap   = await html2canvas(c, { backgroundColor:'#f2efe9', scale:1.5, useCORS:true, logging:false });
    const { jsPDF } = window.jspdf;
    const iw = cap.width, ih = cap.height;
    const pdf = new jsPDF({ orientation: iw > ih ? 'landscape' : 'portrait', unit:'px', format:[iw,ih] });
    pdf.addImage(cap.toDataURL('image/jpeg', 0.92), 'JPEG', 0, 0, iw, ih);
    pdf.save(slug + '-' + new Date().toISOString().slice(0,10) + '.pdf');
  } finally { c.style.transform = savedT; }
}

// ════════════════════════════════════════════════
// TREE HELPERS
// ════════════════════════════════════════════════
function findNode(id, n=tree) {
  if (!n) return null;
  if (n.id === id) return n;
  for (const c of (n.children||[])) { const f = findNode(id,c); if (f) return f; }
  return null;
}
function findParent(id, n=tree, parent=null) {
  if (!n) return undefined;
  if (n.id === id) return parent;
  for (const c of (n.children||[])) { const p = findParent(id,c,n); if (p !== undefined) return p; }
  return undefined;
}
function buildColorMap(n, inherited='#1c2b3a', map={}) {
  map[n.id] = n.color || inherited;
  for (const c of (n.children||[])) buildColorMap(c, n.color||inherited, map);
  return map;
}
function toggle(id) {
  const n = findNode(id);
  if (!n || !n.children?.length) return;
  n.open = !n.open;
  save(); render();
  if (n.open) autoPanRight(id);
}
function autoPanRight(id) {
  setTimeout(() => {
    const el = document.querySelector(`.node[data-id="${id}"]`);
    if (!el) return;
    const nx2 = parseFloat(el.style.left)*zoom + pan.x + NW*zoom;
    if (nx2 > window.innerWidth*0.82)
      animateTo(pan.x-(nx2-window.innerWidth*0.72), pan.y, zoom);
  }, 40);
}
function setDepth(d) {
  if (!tree) return;
  clearSearch();
  walkDepth(tree, d, 0);
  ['btn-l1','btn-l2','btn-all'].forEach(id => document.getElementById(id)?.classList.remove('on'));
  if (d===1)  document.getElementById('btn-l1')?.classList.add('on');
  if (d===2)  document.getElementById('btn-l2')?.classList.add('on');
  if (d===99) document.getElementById('btn-all')?.classList.add('on');
  save(); render(); fitView();
}
function walkDepth(n, max, cur) {
  n.open = cur < max && !!(n.children?.length);
  for (const c of (n.children||[])) walkDepth(c, max, cur+1);
}

// ════════════════════════════════════════════════
// SEARCH
// ════════════════════════════════════════════════
function onSearch(val) {
  const term = val.trim().toLowerCase();
  document.getElementById('srch-clear').style.display = term ? 'block' : 'none';
  if (!term) { clearSearch(); return; }
  if (!searchActive) { savedOpenState = captureOpen(tree); expandAll(tree); searchActive = true; }
  render(term);
}
function clearSearch() {
  const inp = document.getElementById('search-input');
  if (inp) inp.value = '';
  const clr = document.getElementById('srch-clear');
  if (clr) clr.style.display = 'none';
  if (searchActive && savedOpenState) { restoreOpen(tree, savedOpenState); savedOpenState = null; }
  searchActive = false;
  ['btn-l1','btn-l2','btn-all'].forEach(id => document.getElementById(id)?.classList.remove('on'));
  render();
}
function captureOpen(n) {
  const s = {id:n.id, open:n.open, ch:{}};
  for (const c of (n.children||[])) s.ch[c.id] = captureOpen(c);
  return s;
}
function restoreOpen(n, s) {
  if (s && s.id===n.id) n.open = s.open;
  for (const c of (n.children||[])) if (s?.ch?.[c.id]) restoreOpen(c, s.ch[c.id]);
}
function expandAll(n) {
  if (n.children?.length) { n.open = true; n.children.forEach(expandAll); }
}

// ════════════════════════════════════════════════
// LAYOUT
// ════════════════════════════════════════════════
const NW=216, NH=44, HG=58, VG=9;

function subH(n) {
  if (!n.open || !n.children?.length) return NH+VG;
  return Math.max(NH+VG, n.children.reduce((s,c) => s+subH(c), 0));
}
function layout(n, x, midY, out, depth=0) {
  out.push({n, x, y:midY-NH/2, depth});
  if (n.open && n.children?.length) {
    const tot = n.children.reduce((s,c) => s+subH(c), 0);
    let cy = midY - tot/2;
    for (const c of n.children) { const h=subH(c); layout(c, x+NW+HG, cy+h/2, out, depth+1); cy+=h; }
  }
}

// ════════════════════════════════════════════════
// RENDER
// ════════════════════════════════════════════════
function render(searchTerm='') {
  if (!tree) return;
  const colors = buildColorMap(tree);
  const canvas = document.getElementById('canvas');
  const svg    = document.getElementById('svg-layer');
  const totalH = subH(tree);
  const pos    = [];
  layout(tree, 0, totalH/2+20, pos);

  const W = pos.reduce((m,p) => Math.max(m, p.x+NW), 0) + 150;
  const H = pos.reduce((m,p) => Math.max(m, p.y+NH), 0) + 90;
  canvas.style.width = W+'px'; canvas.style.height = H+'px';
  svg.setAttribute('width', W); svg.setAttribute('height', H);

  canvas.querySelectorAll('.node').forEach(e => e.remove());

  // SVG edges
  let paths = '';
  for (const {n,x,y} of pos) {
    if (!n.open || !n.children?.length) continue;
    const px=x+NW, py=y+NH/2;
    for (const child of n.children) {
      const cp = pos.find(p => p.n===child); if (!cp) continue;
      const cx=cp.x, cy=cp.y+NH/2;
      const col = colors[child.id]||'#888';
      const mx  = px+HG*.48;
      paths += `<path d="M${px},${py} C${mx},${py} ${mx},${cy} ${cx},${cy}" fill="none" stroke="${col}" stroke-width="1.5" opacity="0.22"/>`;
    }
  }
  svg.innerHTML = paths;

  // Match ids for search
  const matchIds = new Set();
  if (searchTerm) for (const {n} of pos) if (n.label.toLowerCase().includes(searchTerm)) matchIds.add(n.id);

  // Nodes
  for (const {n,x,y,depth} of pos) {
    const col     = colors[n.id] || '#4a6070';
    const hasKids = !!(n.children?.length);
    const isRoot  = depth===0;
    const isL1    = depth===1;

    const el = document.createElement('div');
    el.className = 'node' + (hasKids ? '' : ' leaf');
    el.dataset.id = n.id;
    el.style.cssText = `left:${x}px;top:${y}px;width:${NW}px;height:${NH}px;`;

    if (isRoot||isL1) {
      el.style.background  = col;
      el.style.boxShadow   = `0 2px 14px ${col}38`;
    } else if (depth===2) {
      el.style.background  = '#fff';
      el.style.border      = `1px solid #e2ddd6`;
      el.style.borderLeft  = `4px solid ${col}`;
      el.style.boxShadow   = '0 1px 6px rgba(28,43,58,.07)';
    } else {
      el.style.background  = 'var(--surface)';
      el.style.border      = `1px solid #e6e1d8`;
      el.style.borderLeft  = `3px solid ${col}`;
    }

    if (searchTerm) {
      if (matchIds.has(n.id)) el.classList.add('highlighted');
      else el.classList.add('dimmed');
    }

    const txtCol = (isRoot||isL1) ? '#fff' : depth===2 ? '#1c2b3a' : '#3a4f62';
    const txtSz  = isRoot ? '13.5px' : isL1 ? '12.5px' : depth===2 ? '11.5px' : '11px';
    const badge  = (!n.open && hasKids) ? `<span class="node-count" style="color:${txtCol}">${n.children.length}</span>` : '';
    const chevron = hasKids ? `<span class="node-chevron${n.open?' open':''}">▶</span>` : '';

    el.innerHTML = `<div class="node-body">
      <span class="node-lbl" style="color:${txtCol};font-size:${txtSz}">${n.label}</span>
      ${badge}${chevron}
    </div>`;

    let clickTimer = null;
    if (hasKids) {
      el.addEventListener('click', e => {
        if (e.defaultPrevented) return;
        clearTimeout(clickTimer);
        clickTimer = setTimeout(() => toggle(n.id), 220);
      });
    }
    el.addEventListener('dblclick', e => {
      e.preventDefault();
      clearTimeout(clickTimer);
      startRename(n.id);
    });
    el.addEventListener('contextmenu', e => { e.preventDefault(); showCtxMenu(n.id, e.clientX, e.clientY, depth); });

    canvas.appendChild(el);
  }
}

// ════════════════════════════════════════════════
// CONTEXT MENU
// ════════════════════════════════════════════════
function showCtxMenu(id, x, y, depth=99) {
  ctxTargetId = id;
  const isCustom = id.startsWith('u_');
  const isL1node = depth===1;
  document.getElementById('ctx-delete').classList.toggle('disabled', !isCustom);
  document.getElementById('ctx-color').style.display = isL1node ? 'flex' : 'none';
  const menu = document.getElementById('ctx-menu');
  menu.style.display = 'block';
  menu.style.left = x+'px'; menu.style.top = y+'px';
  requestAnimationFrame(() => {
    const r = menu.getBoundingClientRect();
    if (r.right  > window.innerWidth-8)  menu.style.left = (x-r.width)+'px';
    if (r.bottom > window.innerHeight-8) menu.style.top  = (y-r.height)+'px';
  });
}
function hideCtxMenu() { document.getElementById('ctx-menu').style.display='none'; ctxTargetId=null; }

function ctxDoAdd() { const id=ctxTargetId; hideCtxMenu(); openModal('add', id); }
function ctxDoRename() { const id=ctxTargetId; hideCtxMenu(); startRename(id); }
function ctxDoColor() {
  const id=ctxTargetId; hideCtxMenu();
  const n=findNode(id); if(!n) return;
  const picker=document.createElement('input');
  picker.type='color'; picker.value=n.color||'#166638';
  picker.style.cssText='position:fixed;opacity:0;pointer-events:none;top:0;left:0;';
  document.body.appendChild(picker);
  picker.addEventListener('input',  e => { n.color=e.target.value; render(); });
  picker.addEventListener('change', e => { n.color=e.target.value; save(); render(); picker.remove(); });
  picker.addEventListener('blur', () => picker.remove());
  picker.click();
}
function ctxDoDelete() {
  const id=ctxTargetId; hideCtxMenu();
  if (!id.startsWith('u_')) return;
  const n=findNode(id); if(!n) return;
  if (!confirm('Delete "' + n.label + '"?')) return;
  const parent=findParent(id);
  if (parent) parent.children=parent.children.filter(c=>c.id!==id);
  save(); render();
}

// ════════════════════════════════════════════════
// ADD / RENAME MODAL
// ════════════════════════════════════════════════
let modalTargetId = null;
function openModal(mode, id) {
  modalMode=mode; modalTargetId=id;
  const n=findNode(id);
  const overlay=document.getElementById('modal-overlay');
  const inp=document.getElementById('modal-input');
  if (mode==='add') {
    document.getElementById('modal-title').textContent='Add child node';
    document.getElementById('modal-sub').innerHTML='Under: <em>' + escHtml(n?.label||id) + '</em>';
    document.getElementById('modal-ok').textContent='Add';
    inp.value=''; inp.placeholder='Node label…';
  } else {
    document.getElementById('modal-title').textContent='Rename node';
    document.getElementById('modal-sub').innerHTML='';
    document.getElementById('modal-ok').textContent='Save';
    inp.value=n?.label||'';
  }
  overlay.style.display='flex';
  setTimeout(()=>{ inp.focus(); inp.select(); }, 60);
}
function closeModal(e) {
  if (e && e.target!==document.getElementById('modal-overlay')) return;
  document.getElementById('modal-overlay').style.display='none';
  modalTargetId=null;
}
function confirmModal() {
  const v=document.getElementById('modal-input').value.trim();
  if (!v) { document.getElementById('modal-input').focus(); return; }
  if (modalMode==='add') {
    const p=findNode(modalTargetId); if(!p) return;
    if (!p.children) p.children=[];
    p.children.push({id:'u_'+Date.now(), label:v, open:false});
    p.open=true;
  } else {
    const n=findNode(modalTargetId); if(n) n.label=v;
  }
  save(); render();
  document.getElementById('modal-overlay').style.display='none';
  modalTargetId=null;
}
document.getElementById('modal-input').addEventListener('keydown', e => {
  if (e.key==='Enter')  { e.preventDefault(); confirmModal(); }
  if (e.key==='Escape') closeModal();
  e.stopPropagation();
});

// ════════════════════════════════════════════════
// INLINE RENAME (double-click)
// ════════════════════════════════════════════════
function startRename(id) {
  const el=document.querySelector(`.node[data-id="${id}"]`); if(!el) return;
  const n=findNode(id); if(!n) return;
  const rect=el.getBoundingClientRect();
  const inp=document.createElement('input');
  inp.className='rename-input';
  inp.value=n.label;
  inp.style.cssText=`left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;height:${rect.height}px;font-size:${rect.height>50?'13.5':'11.5'}px;`;
  document.body.appendChild(inp);
  inp.focus(); inp.select();
  let committed=false;
  function commit() {
    if (committed) return; committed=true;
    const v=inp.value.trim();
    if (v && v!==n.label) { n.label=v; save(); render(); }
    inp.remove();
  }
  inp.addEventListener('keydown', e => {
    if (e.key==='Enter')  commit();
    if (e.key==='Escape') { committed=true; inp.remove(); }
    e.stopPropagation();
  });
  inp.addEventListener('blur', commit);
}

// ════════════════════════════════════════════════
// PAN & ZOOM  (trackpad-optimised)
// ════════════════════════════════════════════════
const vp = document.getElementById('viewport');

function applyTransform(anim=false) {
  const c = document.getElementById('canvas');
  if (anim) { c.style.transition='transform .3s cubic-bezier(.25,.8,.25,1)'; setTimeout(()=>c.style.transition='',320); }
  c.style.transform = `translate(${pan.x}px,${pan.y}px) scale(${zoom})`;
}
function animateTo(tx,ty,tz) { pan.x=tx; pan.y=ty; zoom=tz; applyTransform(true); }

vp.addEventListener('wheel', e => {
  e.preventDefault();
  if (e.ctrlKey) {
    const f  = e.deltaY < 0 ? 1.06 : .944;
    const nz = Math.min(3, Math.max(.15, zoom*f));
    const r  = vp.getBoundingClientRect();
    const mx = e.clientX-r.left, my = e.clientY-r.top;
    pan.x = mx-(mx-pan.x)*(nz/zoom);
    pan.y = my-(my-pan.y)*(nz/zoom);
    zoom  = nz;
  } else {
    pan.x -= e.deltaX; pan.y -= e.deltaY;
  }
  applyTransform();
}, {passive:false});

let drag=false, dO={x:0,y:0}, pO={x:0,y:0};
vp.addEventListener('mousedown', e => {
  if (e.target.closest('.node')||e.target.closest('#ctx-menu')||e.target.closest('#modal-overlay')||e.target.closest('.rename-input')) return;
  drag=true; dO={x:e.clientX,y:e.clientY}; pO={...pan};
  vp.style.cursor='grabbing';
});
window.addEventListener('mousemove', e => { if(!drag) return; pan.x=pO.x+(e.clientX-dO.x); pan.y=pO.y+(e.clientY-dO.y); applyTransform(); });
window.addEventListener('mouseup',   () => { drag=false; vp.style.cursor='default'; });

function fitView() {
  if (!tree) return;
  const pos=[]; layout(tree, 0, subH(tree)/2+20, pos);
  if (!pos.length) return;
  const pad=70;
  const x0=pos.reduce((m,p)=>Math.min(m,p.x),Infinity)-pad;
  const y0=pos.reduce((m,p)=>Math.min(m,p.y),Infinity)-pad;
  const x1=pos.reduce((m,p)=>Math.max(m,p.x+NW),-Infinity)+pad;
  const y1=pos.reduce((m,p)=>Math.max(m,p.y+NH),-Infinity)+pad;
  const vw=window.innerWidth, vh=window.innerHeight-60;
  const nz=Math.min(vw/(x1-x0), vh/(y1-y0), 1.4);
  animateTo((vw-(x1-x0)*nz)/2-x0*nz, (vh-(y1-y0)*nz)/2-y0*nz+30, nz);
}

// ════════════════════════════════════════════════
// GLOBAL EVENT HANDLERS
// ════════════════════════════════════════════════
document.addEventListener('click', e => {
  if (!e.target.closest('#ctx-menu'))                          hideCtxMenu();
  if (!e.target.closest('#card-menu') && !e.target.closest('.tree-card-btn')) hideCardMenu();
  if (!e.target.closest('#export-wrap'))                       hideExportMenu();
});
document.addEventListener('keydown', e => {
  if (e.key==='Escape') { hideCtxMenu(); closeModal(); hideCardMenu(); hideExportMenu(); hideNewTreeModal(); }
  if ((e.metaKey||e.ctrlKey) && e.key==='f') {
    e.preventDefault();
    const inp = document.getElementById('search-input');
    if (inp && document.getElementById('editor-view').style.display!=='none') { inp.focus(); inp.select(); }
  }
});

// ════════════════════════════════════════════════
// INIT
// ════════════════════════════════════════════════
initRouter();
</script>

