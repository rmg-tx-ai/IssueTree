// ════════════════════════════════════════════════
// MULTI-TREE STORAGE
// ════════════════════════════════════════════════
const STORE_KEY = 'issuetrees_v1';

function loadStore() {
  try {
    const s = localStorage.getItem(STORE_KEY);
    return s ? JSON.parse(s) : { trees:{}, activeId:null };
  } catch(e) { return { trees:{}, activeId:null }; }
}
function saveStore(store) { localStorage.setItem(STORE_KEY, JSON.stringify(store)); }
function genId() { return 'tree_' + Math.random().toString(36).slice(2,9) + '_' + Date.now(); }

function migrateIfNeeded() {
  const old = localStorage.getItem('vzTree_v4');
  if (!old) return;
  const store = loadStore();
  if (Object.keys(store.trees).length > 0) { localStorage.removeItem('vzTree_v4'); return; }
  try {
    const data = JSON.parse(old);
    const id = genId();
    store.trees[id] = {
      id, name: data.label || 'VZ Performance Levers',
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      data
    };
    store.activeId = id;
    saveStore(store);
    localStorage.removeItem('vzTree_v4');
  } catch(e) {}
}

function countNodes(n) { return 1 + (n.children||[]).reduce((s,c) => s + countNodes(c), 0); }

function relTime(iso) {
  const ms = Date.now() - new Date(iso).getTime();
  const m = ms/60000, h = m/60, d = h/24;
  if (d > 30)  return new Date(iso).toLocaleDateString();
  if (d >= 2)  return Math.floor(d) + 'd ago';
  if (d >= 1)  return 'Yesterday';
  if (h >= 1)  return Math.floor(h) + 'h ago';
  if (m >= 1)  return Math.floor(m) + 'min ago';
  return 'Just now';
}

function escHtml(s) {
  return String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ════════════════════════════════════════════════
// STATE
// ════════════════════════════════════════════════
let tree           = null;
let currentTreeId  = null;
